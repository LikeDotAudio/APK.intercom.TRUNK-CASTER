# Rust build output
**/target/
**/target-*/

# Runtime output: regenerated by the caster on every run.
# Configuration files (fader.json, settings.json, relay.json, vendor-policy.json)
# and the manuals are kept.
TRUNK-ADVERTISEMENT/*.json
TRUNK-CASTER-INTERFACE/*.reply.json
TRUNK-USAGE/*.json
TRUNK-USAGE/*.html
TRUNK-USAGE/*.jsonl
# The frames' voices, re-assembled by the caster from the wave sender's cuts.
TRUNK-USAGE/voices/
TRUNK-USERS/*.json
TRUNK-USERS/*.html
TRUNK-CROSS POINTS/*.jsonl
TRUNK-CROSS POINTS/*.log
TRUNK-CROSS POINTS/*.wb
TRUNK-CROSS POINTS/crosspoints.json
TRUNK-CROSS POINTS/seeking.json
TRUNK-CROSS POINTS/*.html
TRUNK-CROSS POINTS/seeks/*.offer.json
TRUNK-SIMULATOR/timeline.json
TRUNK-SIMULATOR/*.html
TRUNK-RELAY/state.json
TRUNK-RELAY/*.html
**/*.tmp
**/*.json.tmp

# Checkout of the public GitHub Pages repository (rebuild.py --publish)
.pages/

# Python bytecode
__pycache__/
*.pyc

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# More runtime output
TRUNK-GLOBAL/*.html
TRUNK-GLOBAL/regions.json
TRUNK-GLOBAL/preferences.jsonl
TRUNK-GLOBAL/trends.json
TRUNK-GLOBAL/trends.json
TRUNK-SIMULATOR/runs/
TRUNK-SIMULATOR/runs.json
TRUNK-RELAY/events.jsonl
TRUNK-USERS/labels.jsonl
TRUNK-USAGE/gains.jsonl

# Simulated year for the public replay (rebuild.py --replay)
.replay/
